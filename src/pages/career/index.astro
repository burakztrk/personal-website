---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const roles = (await getCollection('career')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(roles.map((role) => render(role)));
---

<BaseLayout title="Career" description="Work experience.">
  <div class="panel">
    <span class="panel-title">career/</span>

    <h1>CAREER</h1>

    <ol class="timeline">
      {
        roles.map((role, index) => {
          const { Content } = rendered[index];
          const accentClass = `is-${role.data.accent}`;
          return (
            <li class="timeline-item">
              <div class="timeline-head">
                <span class="nes-badge">
                  <span class={accentClass}>{role.data.dateLabel}</span>
                </span>
                <h2 class="role-title">
                  {role.data.role} <span class="dim">@ {role.data.org}</span>
                </h2>
              </div>
              <div class="body-copy timeline-body">
                <Content />
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .timeline-item {
    border-left: 4px solid var(--line);
    padding-left: var(--space-5);
  }

  .timeline-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .role-title {
    margin: 0;
    font-size: 14px;
  }

  .timeline-body {
    margin: 0;
  }
</style>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';

const infoEntries = await getCollection('info');
const info = infoEntries[0];
const { Content } = await render(info);

const career = (await getCollection('career')).sort((a, b) => a.data.order - b.data.order);

// Doom 1993's own hues pulled up into pastels — army green, blue armour,
// khaki, brick, bone, rust. Kept here rather than in tokens.css: they are
// this one row's palette, not part of the site's theme system.
const tags = [
  { label: 'ANDROID', tone: '#a9bf93' },
  { label: 'CI/CD', tone: '#93a4c0' },
  { label: 'COMPOSE', tone: '#cbb089' },
  { label: 'HOMELAB', tone: '#c98a7d' },
  { label: 'PROXMOX', tone: '#ddd2b8' },
  { label: 'LITELLM', tone: '#cc9a66' },
];
---

<BaseLayout title="Info" description={`${info.data.title} — ${info.data.role}`}>
  <div class="panel">
    <span class="panel-title">info.about</span>

    <div class="info-heading">
      <button
        type="button"
        class="avatar"
        id="avatar-cycle"
        data-images={JSON.stringify([
          withBase('/images/info-avatar/avatar-color.png'),
          withBase('/images/info-avatar/avatar-vivid.png'),
          withBase('/images/info-avatar/avatar-mono.png'),
        ])}
        aria-label="Cycle avatar photo"
      >
        <img src={withBase('/images/info-avatar/avatar-color.png')} alt="" />
      </button>
      <div>
        <h1>{info.data.title}</h1>
        <p class="dim role-line">{info.data.role} &middot; {info.data.location}</p>
      </div>
    </div>

    <div class="body-copy bio">
      <Content />
    </div>

    <div class="badge-row">
      {tags.map((tag) => (
        <span class="tag" style={`--tag: ${tag.tone}`}>
          {tag.label}
        </span>
      ))}
    </div>

    <h2>WORK</h2>
    <div class="section-block">
      {
        career.map((role) => (
          <div class="divider-row">
            <span class="dim role-date">{role.data.dateLabel}</span>
            <span class="body-copy">
              {role.data.role} @ {role.data.org}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const avatar = document.getElementById('avatar-cycle');
  const img = avatar?.querySelector('img');
  const images: string[] = avatar ? JSON.parse(avatar.dataset.images ?? '[]') : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let index = 0;
  let animating = false;

  function cycle() {
    if (!avatar || !img || images.length < 2 || animating) return;

    index = (index + 1) % images.length;
    const next = images[index];

    if (reduceMotion) {
      img.src = next;
      return;
    }

    animating = true;
    img.classList.remove('is-cycling');
    // Force reflow so the animation restarts on repeated triggers.
    void img.offsetWidth;
    img.classList.add('is-cycling');

    // Swap the frame once the blinds have fully closed (blackout phase
    // starts at 260ms), matching the page-transition's own timing.
    window.setTimeout(() => {
      img.src = next;
    }, 260);

    window.setTimeout(() => {
      img.classList.remove('is-cycling');
      animating = false;
    }, 500);
  }

  const AUTO_CYCLE_MS = 5000;
  let autoTimer: ReturnType<typeof window.setInterval> | undefined;

  function restartAutoCycle() {
    window.clearInterval(autoTimer);
    if (images.length > 1) autoTimer = window.setInterval(cycle, AUTO_CYCLE_MS);
  }

  avatar?.addEventListener('click', () => {
    cycle();
    restartAutoCycle();
  });
  avatar?.addEventListener('mouseenter', () => {
    cycle();
    restartAutoCycle();
  });

  restartAutoCycle();
</script>

<style>
  .info-heading {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin: var(--space-4) 0 var(--space-5);
  }

  .avatar {
    width: 128px;
    height: 128px;
    padding: 0;
    background: var(--raised);
    border: 4px solid var(--line);
    flex-shrink: 0;
    overflow: hidden;
    cursor: pointer;
    line-height: 0;
  }

  .avatar:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 2px;
  }

  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  /* GameBoy-style swap, same design language as src/styles/transitions.css
     (steps() timing, brightness flash, sepia settle, blinds blackout, then
     a clipped reveal of the next frame) — scaled down to the avatar. */
  .avatar img.is-cycling {
    animation:
      avatar-flash 60ms steps(1, end) forwards,
      avatar-settle 60ms steps(1, end) 60ms forwards,
      avatar-blinds 140ms steps(6, end) 120ms forwards,
      avatar-blackout 40ms steps(1, end) 260ms forwards,
      avatar-reveal 200ms steps(6, end) 300ms forwards;
  }

  @keyframes avatar-flash {
    from {
      filter: brightness(1);
    }
    to {
      filter: brightness(6) contrast(1.2);
    }
  }

  @keyframes avatar-settle {
    from {
      filter: brightness(6) contrast(1.2);
    }
    to {
      filter: sepia(0.6) saturate(2.4) brightness(0.85) hue-rotate(-10deg);
    }
  }

  @keyframes avatar-blinds {
    from {
      filter: sepia(0.6) saturate(2.4) brightness(0.85) hue-rotate(-10deg);
      clip-path: inset(0 0 0 0);
    }
    to {
      filter: brightness(0);
      clip-path: inset(50% 0 50% 0);
    }
  }

  @keyframes avatar-blackout {
    from,
    to {
      filter: brightness(0);
      clip-path: inset(50% 0 50% 0);
    }
  }

  @keyframes avatar-reveal {
    from {
      filter: brightness(0);
      clip-path: inset(50% 0 50% 0);
    }
    to {
      filter: brightness(1);
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar img.is-cycling {
      animation: none;
    }
  }

  .role-line {
    margin: 0;
    font-size: 17px;
  }

  .bio {
    margin: 0 0 var(--space-4);
  }

  .badge-row {
    display: flex;
    /* Wider than the 3px the tags' cut corners bleed, so they never touch. */
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  /* Same cut-corner trick nes.css uses for its badges — a plus-shaped shadow
     in the fill colour — but sized down and driven by --tag, since nes.css
     hardcodes its own palette and won't take these tones. */
  .tag {
    font-family: var(--font-display);
    font-size: 9px;
    line-height: 1;
    padding: 5px 7px;
    color: #1f1913;
    background: var(--tag);
    box-shadow:
      0 3px var(--tag),
      0 -3px var(--tag),
      3px 0 var(--tag),
      -3px 0 var(--tag);
  }

  .section-block {
    margin-bottom: var(--space-8);
  }

  .role-date {
    font-size: 16px;
  }
</style>

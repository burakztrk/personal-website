---
import SiteHeader from '../components/SiteHeader.astro';
import NavBar from '../components/NavBar.astro';
import '../styles/global.css';
import '../styles/transitions.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "ozturk.ai — Burak Ozturk's personal site." } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title} · ozturk.ai</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=DotGothic16&display=swap"
    />

    <script is:inline>
      // Runs before any stylesheet paints, so there is no flash of the wrong
      // theme. Kept intentionally tiny and dependency-free — the richer
      // get/set/toggle helpers used by the theme button live in
      // src/scripts/theme.ts.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'dark' || stored === 'light' || stored === 'doom' ? stored : 'doom';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'doom';
        }
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <NavBar current={pathname} />
    <main class="page">
      <slot />
    </main>

    <script>
      import { initPageTransitions } from '../scripts/transitions';
      initPageTransitions();
    </script>
  </body>
</html>

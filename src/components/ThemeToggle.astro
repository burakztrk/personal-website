<button type="button" id="theme-toggle" class="nes-btn" title="Switch theme">
  <span id="theme-toggle-icon" aria-hidden="true">&#9728;&#65038;</span>
</button>

<style>
  #theme-toggle {
    font-size: 14px;
    line-height: 1;
    padding: 6px 10px;
  }
</style>

<script>
  import { cycleTheme, nextTheme, type Theme } from '../scripts/theme';

  // Show the theme you'd switch TO, the usual convention for a theme button.
  // The variation selector keeps these as glyphs rather than colour emoji,
  // which would sit badly next to the pixel typeface.
  const ICONS: Record<Theme, string> = {
    dark: '☽︎',
    light: '☀︎',
    doom: '☠︎',
  };

  const button = document.getElementById('theme-toggle');
  const icon = document.getElementById('theme-toggle-icon');

  function sync() {
    const next = nextTheme();
    if (icon) icon.textContent = ICONS[next];
    button?.setAttribute('aria-label', `Switch to ${next} theme`);
  }

  button?.addEventListener('click', () => {
    cycleTheme();
    sync();
  });

  sync();
</script>

<button
  type="button"
  id="theme-toggle"
  class="nes-btn"
  aria-label="Toggle theme: light/dark"
  title="Toggle theme"
>
  <span id="theme-toggle-icon" aria-hidden="true">&#9789;</span>
</button>

<style>
  #theme-toggle {
    font-size: 14px;
    line-height: 1;
    padding: 6px 10px;
  }
</style>

<script>
  import { getCurrentTheme, toggleTheme } from '../scripts/theme';

  function syncIcon() {
    const icon = document.getElementById('theme-toggle-icon');
    if (!icon) return;
    // Sun for "switch to light is not needed" — show the icon for the
    // theme you'd switch TO, which is the common convention.
    icon.textContent = getCurrentTheme() === 'dark' ? '☀' : '☽';
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    toggleTheme();
    syncIcon();
  });

  syncIcon();
</script>

---
import DoomFace from './DoomFace.astro';
import { withBase } from '../utils/url';

interface Props {
  current: string;
}

const { current } = Astro.props;

const items = [
  { key: 'info', label: 'INFO', href: withBase('/'), accent: 'is-error' },
  { key: 'blog', label: 'BLOG', href: withBase('/blog'), accent: 'is-warning' },
  { key: 'career', label: 'CAREER', href: withBase('/career'), accent: 'is-success' },
  { key: 'contact', label: 'CONTACT', href: withBase('/contact'), accent: 'is-primary' },
] as const;

// Split either side of the face, the way Doom's status bar brackets it
// between the ARMS and ARMOR panels.
const half = Math.ceil(items.length / 2);
const groups = [items.slice(0, half), items.slice(half)];

// `current` (Astro.url.pathname) is already base-prefixed, so comparisons
// against the base-prefixed hrefs above stay correct either way.
function isActive(href: string): boolean {
  if (href === withBase('/')) return current === href;
  return current === href || current.startsWith(`${href}/`);
}
---

<nav class="site-chrome" aria-label="Primary navigation">
  <div class="nav-bar">
    {
      groups.map((group, index) => (
        <>
          <div class="nav-group">
            {group.map((item) => {
              const active = isActive(item.href);
              return (
                <a
                  href={item.href}
                  class="nav-link nes-badge"
                  data-accent={item.accent}
                  aria-current={active ? 'page' : undefined}
                >
                  <span class={active ? item.accent : 'is-dark'}>{item.label}</span>
                </a>
              );
            })}
          </div>
          {index === 0 && (
            <a class="nav-face" href={withBase('/')} aria-label="Info">
              <DoomFace />
            </a>
          )}
        </>
      ))
    }
  </div>
</nav>

<style>
  /* The bar docks fixed to the bottom of the screen at every viewport width
     (within thumb's reach on phones, within eye's reach on desktop) rather
     than sitting in flow under the header, where scrolling carries it out
     of view. Capped to the page's own max-width so it doesn't stretch
     edge-to-edge on wide viewports. */
  nav.site-chrome {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    margin: 0;
    padding: 0;
    width: calc(100% - var(--space-6));
    max-width: 1040px;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    /* Raised rather than surface: nes.css paints an is-dark badge #212529,
       which is exactly the dark theme's --surface, so inactive badges would
       otherwise dissolve into the bar. */
    background: var(--raised);
    border: 4px solid var(--line);
    border-radius: 4px;
    box-sizing: border-box;
    /* Stamped-metal lip, the thing that sells the row as a HUD panel rather
       than a plain bar. Rendered as light-on-top/dark-underneath so it reads
       the same way whichever theme is painting the surface. The bar floats
       over page content at every width now, so it always carries its own
       elevation shadow rather than relying on being visually "under" the
       header. */
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 7%),
      inset 0 -3px 0 rgb(0 0 0 / 28%),
      0 6px 16px rgb(0 0 0 / 45%);
  }

  .nav-group {
    display: flex;
    align-items: center;
    /* Spread across the half rather than huddling by the face, so the row
       fills its width the way the game's panels do. */
    justify-content: space-evenly;
    gap: var(--space-4);
    /* Equal shares regardless of how wide each side's labels are, which is
       what keeps the face dead centre; max-content stops a side from
       wrapping if its share is the tighter of the two. */
    flex: 1 1 0;
    min-width: max-content;
  }

  /* The face sits in a recessed centre panel bracketed by full-height
     dividers, which is what makes the row read as Doom's status bar rather
     than as a plain row of buttons. */
  .nav-face {
    display: flex;
    align-items: center;
    align-self: stretch;
    flex-shrink: 0;
    text-decoration: none;
    padding: var(--space-2) var(--space-5);
    margin: calc(-1 * var(--space-3)) 0;
    /* Same well colour as the face itself, so the panel reads as one screen
       rather than a frame around a second frame. */
    background: var(--screen);
    border-left: 3px solid var(--line);
    border-right: 3px solid var(--line);
    box-shadow: inset 0 0 0 2px rgb(0 0 0 / 35%);
  }

  /* nes.css sizes a badge to its own em width and spaces it with a margin;
     override both so every label occupies the same fixed box and the flex
     gap alone controls the spacing. The colour lives on the inner span,
     which nes.css absolutely positions to fill this width. */
  .nav-link {
    width: 104px;
    height: 24px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 10px;
    text-decoration: none;
  }

  .nav-link span {
    line-height: 24px;
  }

  /* Below roughly 680px two buttons abreast stop fitting either side of the
     face. Stack each half instead, which keeps the face where it belongs —
     in the middle of the buttons — rather than banished to its own row. */
  @media (max-width: 680px) {
    nav.site-chrome {
      left: var(--space-3);
      right: var(--space-3);
      transform: none;
      width: auto;
    }

    .nav-bar {
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .nav-group {
      flex-direction: column;
      /* Wide enough that the badges' pixel outlines, which bleed half an em
         past the box, don't touch when stacked. */
      gap: var(--space-3);
    }

    .nav-link {
      width: 88px;
      font-size: 9px;
    }

    .nav-face {
      padding: var(--space-2) var(--space-3);
    }
  }
</style>

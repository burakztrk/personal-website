---
import { withBase } from '../utils/url';

interface Props {
  current: string;
}

const { current } = Astro.props;

const items = [
  { key: 'info', label: 'INFO', href: withBase('/'), accent: 'is-primary' },
  { key: 'blog', label: 'BLOG', href: withBase('/blog'), accent: 'is-warning' },
  { key: 'career', label: 'CAREER', href: withBase('/career'), accent: 'is-success' },
  { key: 'contact', label: 'CONTACT', href: withBase('/contact'), accent: 'is-error' },
] as const;

// `current` (Astro.url.pathname) is already base-prefixed, so comparisons
// against the base-prefixed hrefs above stay correct either way.
function isActive(href: string): boolean {
  if (href === withBase('/')) return current === href;
  return current === href || current.startsWith(`${href}/`);
}
---

<nav class="site-chrome" aria-label="Primary navigation">
  <div class="nav-bar">
    {
      items.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`nav-link nes-btn ${active ? item.accent : ''}`}
            data-accent={item.accent}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
  </div>
</nav>

<style>
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-6);
    background: var(--surface);
    border: 4px solid var(--line);
    border-radius: 4px;
    box-sizing: border-box;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 10px;
    text-decoration: none;
  }
</style>

---
import fs from 'node:fs';
import path from 'node:path';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/url';

// Randomized avatar: any image dropped in public/gifs/ is a candidate,
// picked client-side on load. Empty folder = keep the "GIF SOON"
// placeholder, nothing else changes. See public/gifs/README.md.
const gifsDir = path.join(process.cwd(), 'public', 'gifs');
let gifFiles: string[] = [];
try {
  gifFiles = fs
    .readdirSync(gifsDir)
    .filter((file) => /\.(gif|webp|png|jpe?g)$/i.test(file));
} catch {
  gifFiles = [];
}
---

<header class="site-chrome site-header">
  <a href={withBase('/')} class="brand">ozturk<span class="brand-dot">.</span>ai</a>

  <div class="site-header-actions">
    <ThemeToggle />
    <div
      class="gif-slot"
      id="gif-slot"
      data-gifs={JSON.stringify(gifFiles)}
      title={gifFiles.length > 0 ? 'Random avatar' : 'Coming soon: 8-bit face GIF avatar'}
    >
      <span>GIF<br />SOON</span>
    </div>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-dot {
    color: var(--warning);
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .gif-slot {
    width: 44px;
    height: 44px;
    border: 3px dashed var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    flex-shrink: 0;
    overflow: hidden;
  }

  .gif-slot.has-gif {
    border-style: solid;
  }

  .gif-slot span {
    font-family: var(--font-display);
    font-size: 6px;
    line-height: 1.6;
    color: var(--ink-dim);
    text-align: center;
  }

  .gif-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
</style>

<script>
  import { withBase } from '../utils/url';

  const slot = document.getElementById('gif-slot');
  const files: string[] = slot ? JSON.parse(slot.dataset.gifs ?? '[]') : [];

  if (slot && files.length > 0) {
    const pick = files[Math.floor(Math.random() * files.length)];
    const img = document.createElement('img');
    img.src = withBase(`/gifs/${pick}`);
    img.alt = '';
    slot.replaceChildren(img);
    slot.classList.add('has-gif');
  }
</script>

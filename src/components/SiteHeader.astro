---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/url';
---

<header class="site-chrome site-header">
  <a href={withBase('/')} class="brand">ozturk.ai</a>

  <div class="site-header-actions">
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* The DOOM-logo two-tone: a vertical steel-to-gold gradient clipped to
     the glyphs, lifted off the page with a flat drop-shadow standing in for
     the real logo's bevel (the font's own chunky, angled letterforms carry
     most of that read already). --brand-top/--brand-bottom and --line
     shift per theme (see tokens.css), so the whole mark re-colors live
     when the theme toggle cycles instead of being a fixed image. */
  .brand {
    font-family: 'AmazDoomLeft', var(--font-display);
    font-size: 60px;
    line-height: 1;
    letter-spacing: 1px;
    text-decoration: none;
    background: linear-gradient(180deg, var(--brand-top) 0%, var(--brand-bottom) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(3px 3px 0 var(--line));
    /* AmazDoomLeft has almost no descender, so its ink sits well above the
       line box's geometric center no matter what line-height says (the
       offset comes from the font's own ascent/descent split, which
       line-height can't rebalance). Nudge it down by eye so it lines up
       with the theme-toggle button next to it instead of floating above
       it. Expressed in em so it scales with the mobile font-size too. */
    transform: translateY(0.1em);
  }

  @media (max-width: 420px) {
    .brand {
      font-size: 44px;
    }
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
</style>

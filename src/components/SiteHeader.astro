---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/url';
---

<header class="site-chrome site-header">
  <a href={withBase('/')} class="brand">ozturk<span class="brand-dot">.</span>ai</a>

  <div class="site-header-actions">
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-dot {
    color: var(--warning);
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
</style>
